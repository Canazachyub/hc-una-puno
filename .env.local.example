# Copia este archivo como .env.local (no se sube al repositorio).

# Dirección del Web App de Apps Script. La app la trae incorporada: en el celular solo
# se pide usuario y contraseña. En GitHub va como variable del repositorio HC_API_URL.
VITE_API_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec

# Hoja de cálculo y carpeta de Drive del servidor en línea (enlaces). Deben estar en «Restringido».
HC_HOJA=
HC_CARPETA_DRIVE=

# Para `npm run kb:build` (carga tus notas de Semiología en la hoja Knowledge).
HC_USUARIO=admin
HC_CLAVE=tu_contraseña
HC_NOTAS_DIR=C:\Users\User\Documents\CEREBRO DIGITAL\MEDICINA UNAP\MEDICINA UNAP\wiki\SEMIOLOGIA\clases
